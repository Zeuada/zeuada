---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../../lib/format';

export async function getStaticPaths() {
  const updates = await getCollection('updates');
  return updates.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'updates'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="wrap section">
    <div class="prose">
      <p class="muted small"><a href="/updates/">Updates</a> · <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time></p>
      <h1>{entry.data.title}</h1>
      <Content />
    </div>
  </article>
</BaseLayout>
