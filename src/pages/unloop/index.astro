---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhoneFrame from '../../components/PhoneFrame.astro';
import PlayButton from '../../components/PlayButton.astro';
import FaqList from '../../components/FaqList.astro';
import { unloopAppLd } from '../../lib/jsonld';
import {
  builtFeatures,
  comparison,
  featuredResearchIds,
  isBuilt,
  privacyPoints,
  problems,
  publishedResearch,
  steps,
} from '../../data/unloop';

const science = featuredResearchIds
  .map((id) => publishedResearch.find((r) => r.id === id))
  .filter((r) => r !== undefined);
const sharedReels = isBuilt('shared-reels');
---
<BaseLayout
  title="Unloop — take your time back from Reels"
  description="Unloop is an Android app that helps you break the Instagram Reels habit with a mindful pause, a live reel counter, and better things to do. Built on behaviour science, designed without shame."
  jsonLd={[unloopAppLd()]}
>
  <div class="theme-unloop">
    <section class="hero wrap">
      <div>
        <p class="product">Unloop, by Zeuada</p>
        <h1>Take your time back from Reels.</h1>
        <p class="lede">
          Unloop catches the scroll before it catches you, with a pause, a better option, and a live count of your day.
          Built on behaviour science, designed without shame.
        </p>
        <div class="actions">
          <PlayButton label="Get it on Google Play" />
          <span class="muted small">Android. Works with Instagram Reels.</span>
        </div>
      </div>
      <div class="visual">
        <PhoneFrame label="Unloop pause screen with today’s count" />
      </div>
    </section>
  </div>

  <section class="section wrap" aria-labelledby="problem">
    <div class="section-head">
      <h2 id="problem">Why Reels are hard to stop</h2>
    </div>
    <ul class="list-grid">
      {
        problems.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="aside muted">
      Blocking doesn’t fix the habit. Hard blocks get switched off, and they cut off the parts of Instagram that are good
      for you too, like messaging friends.
    </p>
  </section>

  <section class="section wrap" id="how-it-works" aria-labelledby="how">
    <div class="section-head">
      <h2 id="how">How it works: pause, choose, recharge</h2>
      <p>Unloop interrupts the loop at the feeling behind the scroll, not with a lock on the app.</p>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="aside muted">
      Throughout, a live counter shows today’s reels and minutes, so you always know where the day stands.
    </p>
  </section>

  <section class="section wrap" aria-labelledby="science">
    <div class="section-head">
      <h2 id="science">Every feature has a reason</h2>
      <p>
        Unloop’s design is grounded in published research on habits, attention and behaviour change. These findings
        describe the techniques Unloop uses, not results measured with Unloop.
      </p>
    </div>
    <ul class="list-grid">
      {
        science.map((r) => (
          <li>
            <h3>{r.title}</h3>
            <p>{r.line}</p>
          </li>
        ))
      }
    </ul>
    <p class="more"><a class="text-link" href="/unloop/research/">Read the research and sources</a></p>
  </section>

  <section class="section wrap" aria-labelledby="features">
    <div class="section-head">
      <h2 id="features">What Unloop does</h2>
      <p>Everything listed here is in the app today.</p>
    </div>
    <ul class="feature-list">
      {
        builtFeatures.map((f) => (
          <li>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap" aria-labelledby="only-reels">
    <div class="prose">
      <h2 id="only-reels">Only Reels. Not your friends.</h2>
      <p>
        Unloop recognises the Reels feed specifically. Your messages, stories and the rest of Instagram work exactly as
        before. Talking to people you care about is one of the most meaningful things a phone does, and Unloop leaves it
        alone.
      </p>
      {sharedReels && <p>A reel a friend sends you in a chat plays without a pause. Swiping on into more reels brings the pause back.</p>}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="privacy">
    <div class="prose">
      <h2 id="privacy">Private by design</h2>
      <ul>{privacyPoints.map((p) => <li>{p}</li>)}</ul>
      <p><a href="/unloop/privacy/">Read the full privacy policy</a></p>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="compare">
    <div class="section-head">
      <h2 id="compare">How Unloop is different</h2>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Many screen-time apps</th>
            <th scope="col">Unloop</th>
          </tr>
        </thead>
        <tbody>
          {
            comparison.map((row) => (
              <tr>
                <td class="muted">{row.others}</td>
                <td>{row.unloop}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="faq">
    <div class="section-head">
      <h2 id="faq">Questions</h2>
    </div>
    <FaqList />
    <p class="more">More help on the <a href="/unloop/support/">support page</a>.</p>
  </section>

  <div class="theme-unloop">
    <section class="section wrap cta" aria-labelledby="cta">
      <h2 id="cta">Notice the scroll. Choose your day.</h2>
      <div class="actions">
        <PlayButton label="Get it on Google Play" />
      </div>
    </section>
  </div>

  <p class="wrap tm small muted">
    Instagram and Reels are trademarks of Meta Platforms, Inc. Unloop is an independent app and is not affiliated with,
    endorsed by, or sponsored by Meta.
  </p>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-8);
  }

  .hero h1 {
    font-size: clamp(2.3rem, 1.6rem + 3.2vw, 4rem);
    max-width: 13ch;
  }

  .product {
    color: var(--accent);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .visual {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  .aside {
    max-width: var(--measure);
    margin-top: var(--space-6);
    margin-bottom: 0;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-6) var(--space-7);
  }

  .num {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--unloop-ink);
    color: var(--unloop-amber);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .steps h3 {
    margin-bottom: var(--space-2);
  }

  .steps p {
    color: var(--muted);
    margin: 0;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2 20rem;
    column-gap: var(--space-7);
  }

  .feature-list li {
    break-inside: avoid;
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .feature-list h3 {
    font-size: var(--step-0);
    margin-bottom: var(--space-1);
  }

  .feature-list p {
    color: var(--muted);
    margin: 0;
  }

  .table-wrap {
    max-width: 56rem;
    overflow-x: auto;
  }

  .table-wrap td {
    font-size: var(--step-0);
  }

  .more {
    margin-top: var(--space-6);
    margin-bottom: 0;
  }

  .cta {
    text-align: left;
  }

  .cta h2 {
    max-width: 20ch;
  }

  .tm {
    padding-top: var(--space-5);
    margin: 0;
  }
</style>
