{
  "name": "zeuada-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "spell": "cspell --no-progress --gitignore",
    "validate": "html-validate \"dist/**/*.html\"",
    "links": "linkinator dist --recurse --verbosity error --skip \"^(mailto:|https?://(?!(localhost|127\\\\.0\\\\.0\\\\.1)))\"",
    "lhci": "lhci autorun",
    "og": "node scripts/og.mjs",
    "placeholders": "node scripts/placeholders.mjs",
    "verify": "npm run check && npm run spell && npm run build && npm run validate && npm run links",
    "links:external": "linkinator dist --recurse --verbosity error --skip \"^mailto:\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/onest": "^5.3.1",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "cspell": "^10.3.6",
    "html-validate": "^11.16.1",
    "linkinator": "^8.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
